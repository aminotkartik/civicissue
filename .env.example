# ---------------------------------------------------------------------------
# CivicIssue environment configuration
# Copy to `.env` and fill in values. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# SQLite (local development / demo mode):
DATABASE_URL="file:./data/civicissue.db"
# PostgreSQL (production — Supabase, Neon, Railway, self-hosted):
# DATABASE_URL="postgres://user:password@host:5432/civicissue"

# --- Authentication ---------------------------------------------------------
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-32bytes!"

# Optional Google OAuth (button hidden when not configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI provider (optional — deterministic fallback is used when absent) ----
# Supported: "groq" | "openai" | "none"
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"
AI_VISION_MODEL="meta-llama-4-scout-17b-16e-instruct"

# --- Maps -------------------------------------------------------------------
# CivicIssue uses OpenStreetMap + Leaflet (no token required).
# Nominatim geocoding is used for address search (public endpoint by default).
NEXT_PUBLIC_MAP_PROVIDER="osm"
NOMINATIM_URL="https://nominatim.openstreetmap.org"

# --- File storage ------------------------------------------------------------
# Supported: "local" (development) | "s3" (production, S3-compatible)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./data/uploads"
# S3-compatible configuration (used when STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""
STORAGE_S3_ENDPOINT=""
NEXT_PUBLIC_STORAGE_BASE_URL=""

# --- Email notifications (optional — in-app notifications always work) -------
# Supported: "resend" | "none"
EMAIL_PROVIDER="none"
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="CivicIssue <no-reply@civicissue.app>"
# Public base URL used in email links (e.g. password reset)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Demo seed accounts ------------------------------------------------------
# Password used for ALL demo accounts created by `npm run db:seed`.
# Change this for any publicly deployed instance.
DEMO_SEED_PASSWORD="CivicDemo!2026"
